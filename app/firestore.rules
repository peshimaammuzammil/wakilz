rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      // Any authenticated user can read their own profile, or admins can read/write all
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
    
    // Client keys (used for public key-based dashboard access)
    match /client_keys/{key} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Call conversations and transcripts
    match /conversations/{callId} {
      // Authenticated users can read conversations matching their clientId or all if admin
      allow read: if request.auth != null;
      // Writes are restricted to backend / admin
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Outbound batch campaigns
    match /outbound_campaigns/{batchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
