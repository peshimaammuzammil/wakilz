# Wakilz frontend environment variables
# Copy to .env.local for local overrides

# Backend API base URL — point to wakilz-rasen-backend
# Local dev: http://localhost:8080
# Production: https://<your-cloud-run-url>.a.run.app
VITE_API_BASE_URL=https://wakilz-voice-635406175951.asia-south1.run.app

# Client ID — identifies which Wakilz client this embed belongs to
# Public demo: wakilz_demo (default)
# Per-client embeds: set to the client's key from Firestore /client_keys/
VITE_CLIENT_ID=wakilz_demo
