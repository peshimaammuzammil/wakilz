# Wakilz frontend environment variables
# Copy to .env.local for local overrides

# Backend API base URL (local server: http://localhost:7860, prod: HF Space / Cloud Run)
VITE_API_BASE_URL=http://localhost:7860

# Conversations API key (set CONVERSATIONS_API_KEY on backend to match)
# Leave empty for open/demo access
VITE_CONVERSATIONS_API_KEY=
